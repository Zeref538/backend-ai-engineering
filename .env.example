# Copy to .env. .env is gitignored and must stay that way.
# Inside docker compose the host is the service name `db`, not localhost --
# each container has its own localhost, so localhost would mean "myself".
DATABASE_URL=postgres://postgres:dev@db:5432/tasks

# Running the app on your machine against a Postgres container:
# DATABASE_URL=postgres://postgres:dev@localhost:5432/tasks

# Leave DATABASE_URL unset entirely to fall back to the SQLite file.

# --- POST /triage (BE-07) ---------------------------------------------------
# Leave LLM_STUB=1 to run with keyword rules: no key, no spending, no network.
LLM_STUB=1

# Set LLM_STUB=0 and uncomment these to use a real model. These three lines are
# the entire difference between a model on your laptop and one in a datacentre.
#
# Ollama (the lane this project uses): runs on your machine, no account, no key,
# no daily cap. Install from ollama.com, then: ollama pull gemma3:1b
# LLM_BASE_URL=http://localhost:11434/v1/
# LLM_API_KEY=ollama          # ignored by Ollama, but the client needs something
# LLM_MODEL=gemma3:1b
#
# A hosted provider instead? Change the same three values and nothing else.
# OpenRouter needs a key AND both switches ON at openrouter.ai/settings/privacy,
# or every free model answers 404. Free tier is 20/minute and 50/day.

# Seconds before giving up on the model. The OpenAI SDK default is TEN MINUTES.
LLM_TIMEOUT=30

# The kill switch. false = answer instantly with a fallback, make zero calls.
LLM_ENABLED=true
