# Copy to .env. .env is gitignored and must stay that way.
# Inside docker compose the host is the service name `db`, not localhost --
# each container has its own localhost, so localhost would mean "myself".
DATABASE_URL=postgres://postgres:dev@db:5432/tasks

# Running the app on your machine against a Postgres container:
# DATABASE_URL=postgres://postgres:dev@localhost:5432/tasks

# Leave DATABASE_URL unset entirely to fall back to the SQLite file.
