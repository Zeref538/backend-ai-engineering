# Copy to .env and fill in. .env is gitignored and must stay that way.
# Dashboard -> Settings -> API Keys.
#
# Supabase renamed these. The docs now call it the PUBLISHABLE key and it looks
# like sb_publishable_xxx. The older "anon" key (a long eyJ... JWT) still works
# and is what the assignment brief calls it, but Supabase is retiring anon and
# service_role by the end of 2026. Either value goes in SUPABASE_KEY.
#
# Whatever you do, this is the PUBLIC key. The secret / service_role key must
# never go in a file an app ships, and never in a browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_anon_public_key
PORT=3000
