# Copy to .env.local (which is gitignored) and adjust.

# Tells the Inngest SDK to talk to the local Dev Server instead of Inngest Cloud.
# Without this the /api/inngest route answers 500: "in cloud mode but no signing key".
INNGEST_DEV=1

# Leave LLM_STUB=1 to run the whole app with no key and no spending.
# Set it to 0 and fill in a key to use a real model.
LLM_STUB=1
# LLM_API_KEY=your_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
